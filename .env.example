# Acesso
DASHBOARD_PASSWORD=troque-esta-senha
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Banco (local usa arquivo; produção usa Turso)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Chaves padrão, usadas por todos os contextos que não definem uma variável própria.
# GitHub: token classic com escopos repo + read:org (autorize SSO por organização, se exigido).
GITHUB_TOKEN=
# Plane Cloud: API key (Configurações > API tokens).
PLANE_API_KEY=

# Opcional: chaves específicas por contexto (informe o nome na tela Contextos).
# GITHUB_TOKEN_CLIENTE_X=

# Mostra dados fictícios no lugar do GitHub/Plane (para ver a interface sem chaves).
# DEMO_DATA=1
